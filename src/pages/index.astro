---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main>
        <!-- Hero -->
        <section class="bg-gray-900 text-white min-h-[90vh] flex items-center">
            <div class="max-w-6xl mx-auto px-6 py-24">
                <p
                    class="text-orange-400 font-semibold tracking-widest uppercase text-sm mb-4"
                >
                    Construction & Rénovation – Région parisienne
                </p>
                <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6">
                    Des travaux réalisés<br />avec soin et expertise
                </h1>
                <p class="text-gray-300 text-lg md:text-xl max-w-xl mb-10">
                    VP Bâtiment intervient sur tous vos projets de construction
                    et rénovation dans Poissy et la région parisienne.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a
                        href="/contact"
                        class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded transition-colors"
                    >
                        Demander un devis
                    </a>
                    <a
                        href="https://wa.me/33600000000?text=Bonjour%2C%20je%20souhaite%20un%20devis"
                        target="_blank"
                        class="bg-green-600 hover:bg-green-700 text-white font-semibold px-8 py-3 rounded transition-colors"
                    >
                        WhatsApp
                    </a>
                </div>
            </div>
        </section>
        <!-- Services -->
        <section class="py-20 bg-white">
            <div class="max-w-6xl mx-auto px-6">
                <h2 class="text-3xl font-bold text-center mb-4">
                    Nos prestations
                </h2>
                <p class="text-gray-500 text-center max-w-xl mx-auto mb-12">
                    De la démolition à la finition, nous prenons en charge
                    l'ensemble de vos travaux.
                </p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div
                        class="p-6 border border-gray-100 rounded-lg shadow-sm"
                    >
                        <div class="text-4xl mb-4">🏗️</div>
                        <h3 class="text-xl font-semibold mb-2">
                            Construction neuve
                        </h3>
                        <p class="text-gray-500">
                            Maisons individuelles, extensions, dalles et gros
                            œuvre.
                        </p>
                    </div>

                    <div
                        class="p-6 border border-gray-100 rounded-lg shadow-sm"
                    >
                        <div class="text-4xl mb-4">🔨</div>
                        <h3 class="text-xl font-semibold mb-2">Rénovation</h3>
                        <p class="text-gray-500">
                            Rénovation complète ou partielle : plâtrerie,
                            carrelage, peinture, menuiserie.
                        </p>
                    </div>

                    <div
                        class="p-6 border border-gray-100 rounded-lg shadow-sm"
                    >
                        <div class="text-4xl mb-4">🪟</div>
                        <h3 class="text-xl font-semibold mb-2">
                            Aménagement intérieur
                        </h3>
                        <p class="text-gray-500">
                            Cuisines, salles de bain, cloisons, faux plafonds et
                            revêtements de sol.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

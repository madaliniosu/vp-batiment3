---
const navLinks = [
  { label: "Accueil", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Réalisations", href: "/realisations" },
  { label: "À propos", href: "/a-propos" },
  { label: "Contact", href: "/contact" },
];
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
    <a href="/" class="text-xl font-bold text-gray-900">VP Bâtiment</a>
    <ul class="hidden md:flex gap-8">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="text-gray-600 hover:text-gray-900 transition-colors">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>